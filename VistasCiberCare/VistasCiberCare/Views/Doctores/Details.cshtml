        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.apellido)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.apellido)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.cmp)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.cmp)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.celular)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.celular)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.id_especialidad)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.id_especialidad)
        </dd>
