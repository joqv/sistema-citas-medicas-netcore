@model VistasCiberCare.Models.Doctores

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles de Doctor</h1>

<div>
    <h4>Doctores</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.id_doctor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.id_doctor)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.nombre)
        </dt>
        <dd class = "col-sm-10">
