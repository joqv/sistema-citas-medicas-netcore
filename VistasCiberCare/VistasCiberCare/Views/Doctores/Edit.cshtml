@model VistasCiberCare.Models.Doctores

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar Doctor</h1>

<h4>Doctores</h4>
<hr />
@if (ViewBag.mensaje != null)
{
    <div class="alert alert-info">
        @ViewBag.mensaje
    </div>
}
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="id_doctor" class="control-label"></label>
                <input asp-for="id_doctor" class="form-control" readonly />
                <span asp-validation-for="id_doctor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="nombre" class="control-label"></label>
                <input asp-for="nombre" class="form-control" />
                <span asp-validation-for="nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="apellido" class="control-label"></label>
                <input asp-for="apellido" class="form-control" />
                <span asp-validation-for="apellido" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="cmp" class="control-label"></label>
                <input asp-for="cmp" class="form-control" />
                <span asp-validation-for="cmp" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="celular" class="control-label"></label>
                <input asp-for="celular" class="form-control" />
                <span asp-validation-for="celular" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="id_especialidad" class="control-label"></label>
                <select asp-for="id_especialidad" class="form-control" asp-items="ViewBag.Especialidades"></select>
                <span asp-validation-for="id_especialidad" class="text-danger"></span>
            </div>


            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-primary">Retornar</a>

            </div>
        </form>
    </div>
</div>



<div>@ViewBag.mensaje</div>
