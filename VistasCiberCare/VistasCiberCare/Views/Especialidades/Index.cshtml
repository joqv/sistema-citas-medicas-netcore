@model IEnumerable<VistasCiberCare.Models.Especialidades>

@{
    ViewData["Title"] = "Index";
}

<h1>Tabla de Especialidades</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/Especialidades/Insert" class="btn btn-info btn-lg">
        <i class="bi bi-plus-circle"></i> Ingresar nueva Especialidad
    </a>
    <div class="d-flex align-items-center" style="gap: 0;">
        <a asp-action="Index" class="btn btn-secondary me-1">
            <i class="fa-solid fa-reply"></i>
        </a>
        <form asp-action="Index" method="get" class="d-flex" style="max-width: 400px;">
            <input type="text" name="nombre" value="@ViewBag.NombreBusqueda" class="form-control me-2" placeholder="Ingrese especialidad" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.id_especialidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nombre)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.id_especialidad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.nombre)
            </td>
            <td>
                    <a href="/Especialidades/Edit/@item.id_especialidad" class="btn btn-sm btn-primary me-1">
                         <i class="fa-solid fa-pen"></i>Editar
                        <a href="/Especialidades/Details/@item.id_especialidad" class="btn btn-sm btn-info text-white me-1">
                           <i class="fa-solid fa-magnifying-glass"></i> Detalles
                        </a>
                        <a href="/Especialidades/Delete/@item.id_especialidad" class="btn btn-sm btn-danger"
                           onclick="return confirm('¿Estás seguro de eliminar esta Especialidad?');">
                            <i class="fa-solid fa-trash"></i>Eliminar
                        </a>
            </td>
        </tr>
}
    </tbody>
</table>
<nav aria-label="Page navigation">
    <ul class="pagination">
        @for (int i = 1; i <= Math.Ceiling((double)ViewBag.TotalItems / ViewBag.PageSize); i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" href="?page=@i&pageSize=@ViewBag.PageSize">@i</a>
            </li>
        }
    </ul>
</nav>