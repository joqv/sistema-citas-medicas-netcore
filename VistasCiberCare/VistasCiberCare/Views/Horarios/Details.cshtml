        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.id_doctor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.id_doctor)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.apellido)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.apellido)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.disponible)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.disponible)
