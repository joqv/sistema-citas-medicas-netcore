@model VistasCiberCare.Models.Horarios

@{
    ViewData["Title"] = "Insert";
}

<h1>Agregar un nuevo Horario</h1>

<h4>Horarios</h4>
<hr />
@if (ViewBag.mensaje != null)
{
    <div class="alert alert-info">
        @ViewBag.mensaje
    </div>
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Insert">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="fecha" class="control-label"></label>
                <input asp-for="fecha" class="form-control" />
                <span asp-validation-for="fecha" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="hora" class="control-label"></label>
                <input asp-for="hora" class="form-control" />
                <span asp-validation-for="hora" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="id_doctor" class="control-label"></label>
                <select asp-for="id_doctor" class="form-control" asp-items="ViewBag.Doctores">
                    <option value="">-- Seleccione un Doctor --</option>
                </select>
                <span asp-validation-for="id_doctor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="disponible" class="control-label"></label>
                <input asp-for="disponible" class="form-control" />
                <span asp-validation-for="disponible" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-primary">Retornar</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
