@model IEnumerable<VistasCiberCare.Models.Pacientes>

@{
    ViewData["Title"] = "Index";
}

<h1>Tabla de los Pacientes</h1>
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a href="/Pacientes/Insert" class="btn btn-info btn-lg">Ingresar nuevo Paciente</a>
    </div>

    <a href="/Pacientes/ExportarPacientesExcel" class="btn btn-success btn-lg">
        <i class="fa-solid fa-file-excel me-1"></i> Descargar Excel de Pacientes
    </a>

    <a href="/Pacientes/ExportarPacientesPdf" class="btn btn-danger ">
        <i class="fa-solid fa-file-pdf me-1"></i> Exportar Pacientes a PDF
    </a>


    <div class="d-flex align-items-center" style="gap: 0;">
        <a asp-action="Index" class="btn btn-primary me-1">
            <i class="fa-solid fa-reply"></i>
        </a>
        <form asp-action="Index" method="get" class="d-flex" style="max-width: 400px;">
            <input type="text" name="dni" value="@ViewBag.DniBusqueda" class="form-control me-2" placeholder="Ingrese DNI" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>
    </div>
</div>



<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.dni)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.email)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.dni)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.apellido)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.telefono)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.email)
            </td>
            <td>
                    <a href="/Pacientes/Edit/@item.dni" class="btn btn-sm btn-primary me-1">
                        <i class="fa-solid fa-pen"></i> Editar
                    </a>
                    <a href="/Pacientes/Details/@item.dni" class="btn btn-sm btn-info text-white me-1">
                       <i class="fa-solid fa-magnifying-glass"></i> Detalles
                    </a>
                    <a href="/Pacientes/Delete/@item.dni" class="btn btn-sm btn-danger"
                       onclick="return confirm('¿Estás seguro de eliminar este doctor?');">
                         <i class="fa-solid fa-trash"></i>Eliminar
                    </a>
            </td>
        </tr>
}
    </tbody>
</table>
<nav aria-label="Page navigation">
    <ul class="pagination">
        @for (int i = 1; i <= Math.Ceiling((double)ViewBag.TotalItems / ViewBag.PageSize); i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" href="?page=@i&pageSize=@ViewBag.PageSize">@i</a>
            </li>
        }
    </ul>
</nav>
