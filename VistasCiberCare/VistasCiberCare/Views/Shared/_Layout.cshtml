<!--*********************se agregooo*********************************************************************************-->
<!-- Botón flotante del Chatbot -->
<div id="chatbot-btn">
    <a href="https://web-chat.global.assistant.watson.appdomain.cloud/preview.html?backgroundImageURL=https%3A%2F%2Fau-syd.assistant.watson.cloud.ibm.com%2Fpublic%2Fimages%2Fupx-9f755889-73d3-4b47-be4f-d051554ca6d2%3A%3A45f6954c-379c-4dc1-9581-70e705e2ad65&integrationID=b2be3992-d345-4405-bb9e-ba9c039f4af2&region=au-syd&serviceInstanceID=9f755889-73d3-4b47-be4f-d051554ca6d2"
       target="_blank">💬</a>
</div>
<style>
    #chatbot-btn {
        position: fixed;
        bottom: 25px;
        right: 25px;
        width: 60px;
        height: 60px;
        background: #0066ff;
        color: #bff;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 30px;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        z-index: 99999;
        text-decoration: none;
    }

        #chatbot-btn a {
            color: white;
            text-decoration: none;
        }

        #chatbot-btn:hover {
            background: #004ccc;
        }
</style>
<!-- Botón flotante del Chatbot -->
<div id="chatbot-btn">
    <a onclick="openChatbot()" style="cursor:pointer;">💬</a>
</div>
<style>
    #chatbot-btn {
        position: fixed;
        bottom: 25px;
        right: 25px;
        width: 60px;
        height: 60px;
        background: #0066ff;
        color: #btn;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 30px;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        z-index: 99999;
        text-decoration: none;
    }

        #chatbot-btn a {
            color: white;
            text-decoration: none;
        }

        #chatbot-btn:hover {
            background: #004ccc;
        }
</style>
<script>
    // Abrir el chat al hacer clic en el botón
    function openChatbot() {
        if (window.watsonAssistantChatOptionsInstance) {
            window.watsonAssistantChatOptionsInstance.openWindow();
        }
    }
    // Configuración de tu Watson Assistant
    window.watsonAssistantChatOptions = {
        integrationID: "b2be3992-d345-4405-bb9e-ba9c039f4af2", // tu integration ID
        region: "au-syd", // región del servicio
        serviceInstanceID: "9f755889-73d3-4b47-be4f-d051554ca6d2", // tu instance ID
        onLoad: async (instance) => {
            window.watsonAssistantChatOptionsInstance = instance;
            await instance.render();
        }
    };
    // Cargar el script del chat
    setTimeout(function () {
        const t = document.createElement('script');
        t.src = "https://web-chat.global.assistant.watson.appdomain.cloud/versions/"
            + (window.watsonAssistantChatOptions.clientVersion || 'latest')
            + "/WatsonAssistantChatEntry.js";
        document.head.appendChild(t);
    });
</script>
<!-- Botón flotante del Chatbot -->
<!--******************************************************************************************************-->

<body>
